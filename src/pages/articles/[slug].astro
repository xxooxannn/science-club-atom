---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AtomMark from '../../components/AtomMark.astro';

export async function getStaticPaths() {
  const posts = await getCollection('articles', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// Related: same tag first, then the rest by recency (max 2).
const allPosts = (await getCollection('articles', ({ data }) => !data.draft)).filter(
  (p) => p.id !== post.id
);
const related = [
  ...allPosts.filter((p) =>
    p.data.tags.some((t) => post.data.tags.includes(t))
  ),
  ...allPosts,
]
  .slice(0, 2);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="reading-progress" aria-hidden="true"></div>
  <article class="mx-auto max-w-6xl px-5 pt-10 md:px-8 md:pt-16">
    <a
      href="/articles"
      class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-soft transition-colors hover:text-crimson"
    >
      ← All articles
    </a>

    <!-- Header -->
    <header class="mx-auto mt-10 max-w-3xl">
      <div class="flex flex-wrap gap-2">
        {
          post.data.tags.map((tag) => (
            <span class="rounded-full border border-line px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-soft">
              {tag}
            </span>
          ))
        }
      </div>
      <h1 class="mt-6 font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        {post.data.title}
      </h1>
      <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft">
        By {post.data.author}{post.data.authorRole ? ` · ${post.data.authorRole}` : ''} ·
        {formatDate(post.data.pubDate)}
      </p>
    </header>

    {
      post.data.image && (
        <figure class="mx-auto mt-12 max-w-4xl">
          <img
            src={post.data.image}
            alt=""
            width="960"
            height="600"
            loading="eager"
            class="w-full rounded-2xl object-cover ring-1 ring-line"
          />
          <!-- PLACEHOLDER PHOTO — replace with a real club photo -->
        </figure>
      )
    }

    <!-- Body -->
    <div class="prose-atom mx-auto mt-14 max-w-3xl">
      <Content />
    </div>

    <!-- Author box -->
    <div
      class="mx-auto mt-20 max-w-3xl rounded-3xl bg-surface p-7 ring-1 ring-line md:p-8"
    >
      <div class="flex items-center gap-5">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-crimson-wash">
          <AtomMark class="h-7 w-7 text-crimson" strokeWidth={5} />
        </div>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-soft">
            About the author
          </p>
          <p class="mt-1.5 text-lg font-medium">{post.data.author}</p>
          {post.data.authorRole && <p class="text-sm text-ink-soft">{post.data.authorRole}</p>}
        </div>
      </div>
      <p class="mt-5 leading-relaxed text-ink-soft">
        Wrote this for the ATOMS journal. Want to write something too? Members can submit through
        the <a href="/join" class="text-crimson underline underline-offset-4">join page</a> — no
        writing experience needed, just something to say.
      </p>
    </div>

    <!-- Related -->
    {
      related.length > 0 && (
        <nav class="mx-auto mt-20 max-w-3xl" aria-label="Related articles">
          <h2 class="font-display text-2xl font-semibold tracking-tight">Keep reading</h2>
          <ul class="mt-6 divide-y divide-line border-t border-line">
            {related.map((rel) => (
              <li>
                <a
                  href={`/articles/${rel.id}`}
                  class="group grid grid-cols-[1fr_auto] items-baseline gap-4 py-5"
                >
                  <span class="text-lg font-medium transition-colors group-hover:text-crimson max-md:text-base">
                    {rel.data.title}
                  </span>
                  <span
                    class="text-ink-soft transition-transform duration-300 ease-fluid group-hover:translate-x-1 group-hover:text-crimson"
                    aria-hidden="true">→</span
                  >
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</BaseLayout>
