---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<BaseLayout
  title="Articles"
  description="Articles and writing from members of ATOMS — experiments explained, questions chased, findings published."
>
  <section class="mx-auto max-w-6xl px-5 pt-10 md:px-8 md:pt-16">
    <p class="font-mono text-[10px] uppercase tracking-[0.24em] text-crimson">The Journal</p>
    <h1 class="mt-5 font-display text-4xl font-semibold tracking-tight md:text-6xl">
      Articles &amp; writing.
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
      Written by members, for everyone — what we built, what we learned, and what we still argue
      about. Want your piece here? The
      <a href="/join" class="text-crimson underline underline-offset-4">submission form</a> is open.
    </p>
  </section>

  {
    posts.length === 0 ? (
      <section class="mx-auto mt-16 max-w-6xl px-5 md:px-8">
        <p class="rounded-2xl bg-paper-deep p-8 text-ink-soft">
          No articles published yet — be the first to write one.
        </p>
      </section>
    ) : (
      <section class="mx-auto mt-16 max-w-6xl px-5 md:mt-20 md:px-8">
        <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="reveal group flex flex-col">
              {post.data.image && (
                <a
                  href={`/articles/${post.id}`}
                  class="block overflow-hidden rounded-2xl ring-1 ring-line"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <img
                    src={post.data.image}
                    alt=""
                    width="960"
                    height="600"
                    loading="lazy"
                    class="aspect-[8/5] w-full object-cover transition-transform duration-700 ease-fluid group-hover:scale-[1.03]"
                  />
                </a>
              )}
              <div class="mt-5 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded-full border border-line px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-soft">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="mt-4 font-display text-2xl font-semibold leading-tight tracking-tight">
                <a href={`/articles/${post.id}`} class="transition-colors hover:text-crimson">
                  {post.data.title}
                </a>
              </h2>
              <p class="mt-3 flex-1 leading-relaxed text-ink-soft">{post.data.description}</p>
              <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.18em] text-ink-soft">
                {post.data.author} · {formatDate(post.data.pubDate)}
              </p>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
